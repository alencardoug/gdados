---
// Pergunta → view → montagem (view_rules) → fatos e dimensões → linhagem (PLANO §2.1; conceitos §5.2).
import Conceito from "../../../components/Conceito.astro";
import Base from "../../../layouts/Base.astro";
import Md from "../../../components/Md.astro";
import {
  pacote, rota, rotaDaRelacao, rotaDaColuna, rotaDaMetrica, rotaDoFiltro, rotaDaReferencia, mdDoPacoteEmLinha,
} from "../../../lib/portal.mjs";

export function getStaticPaths() {
  return Object.keys(pacote.questions).map((id) => ({ params: { id } }));
}
const id = Astro.params.id;
const q = pacote.questions[id];
const regras = pacote.view_rules[q.view] ?? null;
const auditoria = pacote.view_audits[q.view] ?? null;
const ADITIVIDADE = { additive: "aditiva", semi_additive: "semiaditiva", non_additive: "não aditiva" };
const PAPEL = { grain: "grão", identity: "identidade", measure: "medida", metric: "métrica", reference: "conferida por referência" };
const notas = Object.fromEntries(await Promise.all(q.measures.map(async (m) => [m.column, await mdDoPacoteEmLinha(m.note)])));
const ref = regras?.reference;
const motivo = ref ? await mdDoPacoteEmLinha(ref.reason) : null;
---
<Base titulo={`${id} — ${q.title}`} secao="governanca">
<p class="migalhas"><a href={rota("governanca/")}>Governança</a> › <a href={rota("governanca/perguntas/")}>Perguntas</a></p>
<h1>{id} — {q.title}</h1>
<dl class="ficha">
  <dt>View</dt><dd><a href={rotaDaRelacao(q.view)}><code>{q.view}</code></a></dd>
  <dt>Fatos</dt><dd>{q.facts.map((f) => <div><a href={rotaDaRelacao(f)}><code>{f}</code></a></div>)}</dd>
  <dt>Dimensões</dt><dd>{q.dimensions.map((d) => <div><a href={rotaDaRelacao(d)}><code>{d}</code></a></div>)}</dd>
  <dt>Auditoria da view</dt><dd>{auditoria ? <span class={`estado ${auditoria.status}`}>{auditoria.status}</span> : <span class="ausente">sem auditoria no pacote</span>}</dd>
</dl>
<p>
  <a href={rota(`governanca/linhagem/?r=${q.view}`)}>Seguir a view no grafo por relação</a>{" · "}
  <a href={rota(`governanca/linhagem/?modo=coluna&r=${q.view}`)}>por coluna</a>
</p>

<h2>Medidas da pergunta</h2>
<div class="rolagem"><table>
<thead><tr><th scope="col">Coluna da view</th><th scope="col"><Conceito id="aditividade">Aditividade</Conceito></th><th scope="col">Nota</th></tr></thead>
<tbody>
{q.measures.map((m) => (
  <tr>
    <td><a href={rotaDaColuna(q.view, m.column)}><code>{m.column}</code></a></td>
    <td>{ADITIVIDADE[m.additivity] ?? m.additivity}</td>
    <td class="md">{m.note == null ? <span class="suave">—</span> : <Md html={notas[m.column]} em="span" />}</td>
  </tr>
))}
</tbody></table></div>
<p class="suave">Aditividade é a declarada para a coluna nesta view. O grão da view pode mudá-la: uma medida aditiva na fato pode deixar de ser somável na view.</p>

<h2>Montagem da view</h2>
{regras == null ? <p><span class="ausente">A montagem desta view não está em <code>view_rules</code>.</span></p> : ref ? (
  <>
  <p>Esta view é <strong>conferida por referência</strong>: o montador do projeto não a monta a partir das medidas. Ela é comparada com uma consulta de referência.</p>
  <dl class="ficha">
    <dt>Motivo</dt><dd class="md"><Md html={motivo} em="span" /></dd>
    <dt>Consulta</dt><dd>{rotaDaReferencia(ref.query) ? <a href={rotaDaReferencia(ref.query)}><code>{ref.query}</code></a> : <code>{ref.query}</code>}</dd>
    <dt>Teste</dt><dd><code>{ref.test}</code></dd>
  </dl>
  </>
) : (
  <>
  <h3><Conceito id="grao">Grão</Conceito></h3>
  <div class="rolagem"><table>
  <thead><tr><th scope="col">Coluna</th><th scope="col">Expressão</th></tr></thead>
  <tbody>{Object.entries(regras.grain).map(([c, e]) => <tr><td><code>{c}</code></td><td><code>{e}</code></td></tr>)}</tbody>
  </table></div>
  <h3>Fontes</h3>
  {regras.sources.map((s) => (
    <dl class="ficha">
      <dt>Relação</dt><dd><a href={rotaDaRelacao(s.relation)}><code>{s.relation}</code></a> (apelido <code>{s.alias}</code>)</dd>
      <dt>Data do período</dt><dd>{s.date ? <><code>{s.date.column}</code> — {s.date.label}</> : <span class="ausente">ausente</span>}</dd>
      <dt>Grão de agregação</dt><dd>{s.grain.map((g) => <code>{g}</code>).reduce((a, b) => [a, ", ", b])}</dd>
      <dt>Medidas</dt><dd>{s.measures.map((m) => <a href={rotaDaMetrica(m)}><code>{m}</code></a>).reduce((a, b) => [a, ", ", b])}</dd>
      <dt>Filtros</dt><dd>{s.filters.length ? s.filters.map((f) => <a href={rotaDoFiltro(f)}><code>{f}</code></a>).reduce((a, b) => [a, ", ", b]) : <span class="suave">nenhum</span>}</dd>
      <dt>Junções</dt><dd>{s.joins.length ? s.joins.map((j) => <a href={rotaDaRelacao(j)}><code>{j}</code></a>).reduce((a, b) => [a, ", ", b]) : <span class="suave">nenhuma</span>}</dd>
    </dl>
  ))}
  {regras.combine && (
    <p>
      As duas fontes são combinadas por junção <code>{regras.combine.type}</code> nas chaves {regras.combine.keys.map((k) => <code>{k}</code>).reduce((a, b) => [a, ", ", b])};
      no lado ausente, a medida {regras.combine.missing == null ? "fica nula" : <>vale <code>{String(regras.combine.missing)}</code></>}.
    </p>
  )}
  </>
)}
{regras && (
  <>
  <h3>Papel de cada coluna</h3>
  <div class="rolagem"><table>
  <thead><tr><th scope="col">Coluna</th><th scope="col">Papel</th><th scope="col">Medida ou métrica</th><th scope="col">Aditividade</th><th scope="col">Nota</th></tr></thead>
  <tbody>
  {Object.entries(regras.columns).map(([c, v]) => (
    <tr>
      <td><a href={rotaDaColuna(q.view, c)}><code>{c}</code></a></td>
      <td>{PAPEL[v.role] ?? v.role}</td>
      <td>{v.name ? <a href={rotaDaMetrica(v.name)}><code>{v.name}</code></a> : <span class="suave">—</span>}</td>
      <td>{v.additivity == null ? <span class="suave">não se aplica</span> : (ADITIVIDADE[v.additivity] ?? v.additivity)}</td>
      <td>{v.note ?? <span class="suave">—</span>}</td>
    </tr>
  ))}
  </tbody></table></div>
  </>
)}
</Base>
