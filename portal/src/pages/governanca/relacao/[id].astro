---
// Página de uma relação (PLANO §2.1): significado, ficha, colunas com sensibilidade e domínio de
// valores, linhagem imediata, testes, auditoria e as perguntas que a usam.
import Conceito from "../../../components/Conceito.astro";
import { conceitosQueCitam } from "../../../lib/editorial.mjs";
import Base from "../../../layouts/Base.astro";
import Ausente from "../../../components/Ausente.astro";
import Md from "../../../components/Md.astro";
import Resultado from "../../../components/Resultado.astro";
import {
  relacoes, relacaoPorId, procedencia, pacote, rota, rotaDaRelacao, rotaDaColuna, rotaDaPergunta, rotaDaMetrica,
  rotaDaReferencia, mdDoPacote, mdDoPacoteEmLinha, relacaoDaColuna, nomeDaColuna, metricasPorColuna, commitCurto,
  camadasComChave, naoNulas, modeloER, rotaDoER, amostras, dataHora,
} from "../../../lib/portal.mjs";
import { MARCADOR_PESSOAL } from "../../../lib/origem.mjs";

export function getStaticPaths() {
  return relacoes.map((x) => ({ params: { id: x.id } }));
}
const x = relacaoPorId.get(Astro.params.id);
const r = x.r;
const meta = r.meta ?? {};
const descricao = x.semDescricao ? null : await mdDoPacote(r.description);
const colunas = await Promise.all(
  Object.entries(r.columns).map(async ([nome, c]) => ({
    nome,
    c,
    m: c.meta ?? {},
    descricao: x.colunasSemDescricao.has(nome) ? null : await mdDoPacoteEmLinha(c.description),
    linhagem: x.linhagem?.columns?.[nome] ?? null,
    metricas: metricasPorColuna.get(`${x.id}.${nome}`) ?? [],
  })),
);
const ORIGEM = { source: "origem", seed: "seed", generated: "valor gerado" };
const lnk = (coluna) => (relacaoPorId.has(relacaoDaColuna(coluna)) ? rotaDaColuna(relacaoDaColuna(coluna), nomeDaColuna(coluna)) : null);
const tabelaDeValores = (obj) => Object.entries(obj ?? {});
const auditoria = x.auditoria;
const citada = conceitosQueCitam("relacao", x.id);
// meta.grants além de select (que já está em grants_select), como a gravação do streaming.
const outrasConcessoes = Object.entries(meta.grants ?? {}).filter(([op, v]) => op !== "select" && Array.isArray(v) && v.length);
const refAuditoria = auditoria?.reference ? rotaDaReferencia(auditoria.reference) : null;
// Chaves (F34): a coluna referenciada liga à página da relação de destino; nada é deduzido.
const pk = new Set(x.chavePrimaria);
const fkPorColuna = new Map(x.chavesEstrangeiras.map((f) => [f.column, f]));
const lnkRef = (rel, col) => (relacaoPorId.has(rel) ? rotaDaColuna(rel, col) : null);
const noModelo = modeloER.includes(x.id);
const adr0056 = rotaDaReferencia("docs/adr/0056-chaves-declaradas-em-analytics.md");
const semChave = x.chavePrimaria.length === 0 && x.chavesEstrangeiras.length === 0;
// Amostra de registros (D06; ADR-0058 da origem): exibida como exportada, sem reordenar nem completar.
const amostra = amostras.relations[x.id];
const mascaradas = new Set(amostra.masked_columns);
const adr0058 = rotaDaReferencia("docs/adr/0058-amostras-de-registros-para-o-publico.md");
const jsonDaCelula = (v) => JSON.stringify(v, null, 2);
// Verificações e testes que sustentam a auditoria (view_audits.*.checks e .data_tests).
const sustentacao = auditoria ? [
  ...(auditoria.checks ?? []).map((id) => ({ id, nome: id.split("::").slice(1).join("::") || id, origem: "pytest", resultado: pacote.checks[id]?.result ?? null, existe: id in pacote.checks })),
  ...(auditoria.data_tests ?? []).map((id) => ({ id, nome: pacote.tests[id]?.test ?? id, origem: "dbt", resultado: pacote.tests[id]?.result ?? null, existe: id in pacote.tests })),
] : [];
---
<Base titulo={x.id} secao="governanca" descricao={`Relação ${x.id} no catálogo do portal.`}>
<p class="migalhas"><a href={rota("governanca/")}>Governança</a> › <a href={rota(`governanca/?camada=${x.camada}#catalogo`)}>{x.camada}</a></p>
<h1><code>{x.id}</code></h1>
{x.semDescricao
  ? <p><span class="ausente">Sem descrição declarada</span> <span class="suave">(registrada em <code>description_gaps</code>).</span></p>
  : <Md html={descricao} ausente="descrição ausente" />}

<dl class="ficha">
  <dt><Conceito id="camada">Camada</Conceito> (schema)</dt><dd>{r.schema}</dd>
  <dt>Tipo</dt><dd>{r.resource_type}</dd>
  <dt><Conceito id="materializacao">Materialização</Conceito></dt><dd><Ausente valor={r.materialization} texto={r.resource_type === "source" ? "não se aplica (source)" : "ausente"} /></dd>
  <dt><Conceito id="grao">Grão</Conceito></dt><dd><Ausente valor={r.grain} texto="não declarado" /></dd>
  <dt><Conceito id="dominio">Domínio</Conceito></dt><dd><Ausente valor={meta.domain} texto="não declarado" /></dd>
  <dt><Conceito id="responsavel">Responsável</Conceito></dt><dd><Ausente valor={meta.owner} texto="não declarado" /></dd>
  <dt>Escritores</dt><dd><Ausente valor={meta.writers} texto="não declarados" /></dd>
  <dt><Conceito id="retencao">Retenção</Conceito></dt><dd><Ausente valor={meta.retention} texto="não declarada" /></dd>
  <dt><Conceito id="acesso-por-papel">Papéis com leitura</Conceito></dt><dd>{r.grants_select.length ? r.grants_select.map((g) => <code>{g}</code>).reduce((a, b) => [a, ", ", b]) : <span class="ausente">nenhuma concessão de leitura</span>}</dd>
  {outrasConcessoes.length > 0 && <><dt>Outras concessões</dt><dd>{outrasConcessoes.map(([op, papeis]) => <div><code>{op}</code>: {papeis.map((g) => <code>{g}</code>).reduce((a, b) => [a, ", ", b])}</div>)}</dd></>}
  <dt><Conceito id="chave">Chave primária</Conceito></dt><dd>{x.chavePrimaria.length
    ? x.chavePrimaria.map((c) => <a href={`#coluna-${c}`}><code>{c}</code></a>).reduce((a, b) => [a, ", ", b])
    : <><span class="ausente">nenhuma declarada</span>{semChave && <span class="suave"> (no pacote da {procedencia.ref}, só {camadasComChave.join(", ")} declara chaves)</span>}</>}</dd>
  <dt>Chaves estrangeiras</dt><dd>{x.chavesEstrangeiras.length
    ? x.chavesEstrangeiras.map((f) => <div><a href={`#coluna-${f.column}`}><code>{f.column}</code></a> → {lnkRef(f.references_relation, f.references_column) ? <a href={lnkRef(f.references_relation, f.references_column)}><code>{f.references_relation}.{f.references_column}</code></a> : <code>{f.references_relation}.{f.references_column}</code>}</div>)
    : <span class="ausente">nenhuma declarada</span>}</dd>
  {x.referenciadaPor.length > 0 && <><dt>Referenciada por</dt><dd>{x.referenciadaPor.map((f) => <div>{lnkRef(f.relacao, f.column) ? <a href={lnkRef(f.relacao, f.column)}><code>{f.relacao}.{f.column}</code></a> : <code>{f.relacao}.{f.column}</code>}</div>)}</dd></>}
  {noModelo && <><dt><Conceito id="entidade-e-relacionamento">Diagrama entidade-relacionamento</Conceito></dt><dd><a href={rotaDoER(x.id)}>Ver esta relação e as ligadas a ela por chave</a></dd></>}
  {citada.length > 0 && <><dt>Exemplo nas explicações</dt><dd>{citada.map((t) => <a href={t.href}>{t.titulo}</a>).reduce((a, b) => [a, ", ", b])}</dd></>}
  {x.perguntas.length > 0 && <><dt>Perguntas que a usam</dt><dd>{x.perguntas.map((q) => <a href={rotaDaPergunta(q)}>{q}</a>).reduce((a, b) => [a, ", ", b])}</dd></>}
</dl>

{auditoria && <>
<h2>Auditoria da view</h2>
<dl class="ficha">
  <dt>Estado</dt><dd><span class={`estado ${auditoria.status}`}>{auditoria.status}</span></dd>
  <dt>Commit da auditoria</dt><dd><Ausente valor={auditoria.commit} /></dd>
  <dt>Critérios</dt><dd>{auditoria.criteria.length ? auditoria.criteria.map((c) => <code>{c}</code>).reduce((a, b) => [a, ", ", b]) : <span class="ausente">nenhum</span>}</dd>
  <dt>Achados</dt><dd><Ausente valor={auditoria.findings} texto="nenhum" /></dd>
  <dt>Consulta de referência</dt><dd>{auditoria.reference == null ? <span class="ausente">ausente</span> : refAuditoria ? <a href={refAuditoria}><code>{auditoria.reference}</code></a> : <code>{auditoria.reference}</code>}</dd>
  <dt>O que a sustenta</dt><dd>{sustentacao.length
    ? <ul class="sem-marcador">{sustentacao.map((v) => <li><span class="etiqueta">{v.origem}</span> <code>{v.nome}</code> {v.existe ? <Resultado resultado={v.resultado} /> : <span class="ausente">não encontrado no pacote</span>}</li>)}</ul>
    : <span class="ausente">nenhuma verificação declarada</span>}</dd>
</dl>
<p class="suave">"O que a sustenta" lista as verificações do <code>pytest</code> e os testes do dbt que a origem declara para esta auditoria, com o resultado da execução registrada no pacote.</p>
</>}

<h2><Conceito id="linhagem">Linhagem</Conceito> imediata</h2>
<p>
  <a href={rota(`governanca/linhagem/?r=${x.id}`)}>Ver no grafo por relação</a>{" · "}
  <a href={rota(`governanca/linhagem/?modo=coluna&r=${x.id}`)}>Ver no grafo por coluna</a>
</p>
{r.resource_type === "source" && <p class="suave">Uma <em>source</em> não tem insumo no dbt: é por onde os dados entram. Como chegam até aqui é assunto das <a href={rota("estrutura/#travessias")}>travessias</a>.</p>}
<div class="rolagem"><table>
<thead><tr><th scope="col">Sentido</th><th scope="col">Relação</th><th scope="col">Colunas ligadas</th></tr></thead>
<tbody>
{x.entradas.map((a) => <tr><td>insumo</td><td><a href={rotaDaRelacao(a.source)}><code>{a.source}</code></a></td><td>{a.n}</td></tr>)}
{x.saidas.map((a) => <tr><td>consumidor</td><td><a href={rotaDaRelacao(a.target)}><code>{a.target}</code></a></td><td>{a.n}</td></tr>)}
{x.entradas.length + x.saidas.length === 0 && <tr><td colspan="3"><span class="ausente">nenhuma ligação na linhagem do pacote</span></td></tr>}
</tbody></table></div>
<p class="suave">"Colunas ligadas" conta as ligações de coluna para coluna da linhagem do pacote (<code>leaves</code>). A linhagem diz de onde vem o valor de cada coluna. Uma junção ou um filtro de que a relação também depende pode não aparecer como ligação.</p>

<h2>Colunas</h2>
<div class="rolagem"><table>
<thead><tr><th scope="col">Coluna</th><th scope="col">Tipo</th><th scope="col"><Conceito id="sensibilidade">Sensibilidade</Conceito></th><th scope="col">Descrição</th><th scope="col"><Conceito id="origem-terminal">Origens terminais</Conceito></th></tr></thead>
<tbody>
{colunas.map(({ nome, c, m, descricao, linhagem, metricas }) => (
  <tr id={`coluna-${nome}`}>
    <th scope="row"><code>{nome}</code>{pk.has(nome) && <> <span class="etiqueta" title="chave primária">PK</span></>}{fkPorColuna.has(nome) && <> <span class="etiqueta" title={`chave estrangeira para ${fkPorColuna.get(nome).references_relation}`}>FK</span></>}{fkPorColuna.has(nome) && <div class="suave">{naoNulas.has(`${x.id}.${nome}`) ? "obrigatória (teste not_null)" : "sem teste not_null"}</div>}</th>
    <td><Ausente valor={c.data_type} texto="não declarado no pacote" /></td>
    <td>{c.sensitivity}{m.sensitivity_reason && <div class="suave">{m.sensitivity_reason}</div>}</td>
    <td class="md">
      {x.colunasSemDescricao.has(nome) ? <span class="ausente">sem descrição declarada</span> : <Md html={descricao} em="span" />}
      {m.description_from && <div class="suave">Descrição herdada de <code>{m.description_from}</code>.</div>}
      {m.description_reason && <div class="suave">Motivo da descrição própria: {m.description_reason}</div>}
      {metricas.length > 0 && <div>Publica: {metricas.map((n) => <a href={rotaDaMetrica(n)}><code>{n}</code></a>).reduce((a, b) => [a, ", ", b])}</div>}
      {m.values && (
        <details><summary>Valores{m.value_domain && <> (domínio <code>{m.value_domain}</code>)</>}</summary>
          <table><tbody>{tabelaDeValores(m.values).map(([v, s]) => <tr><td><code>{v}</code></td><td>{s}</td></tr>)}</tbody></table>
        </details>
      )}
      {m.null_meaning && <div><span class="etiqueta">nulo</span> {m.null_meaning}</div>}
      {m.unknown_member && <div><span class="etiqueta">membro desconhecido</span> <code>{m.unknown_member}</code></div>}
      {m.not_observed && <details><summary>Valores não observados no dado atual</summary><table><tbody>{tabelaDeValores(m.not_observed).map(([v, s]) => <tr><td><code>{v}</code></td><td>{s}</td></tr>)}</tbody></table></details>}
      {m.impossible && <details><summary>Valores impossíveis</summary><table><tbody>{tabelaDeValores(m.impossible).map(([v, s]) => <tr><td><code>{v}</code></td><td>{s}</td></tr>)}</tbody></table></details>}
    </td>
    <td>
      {linhagem == null
        ? (r.resource_type === "source" ? <span class="suave">é origem</span> : <span class="ausente">sem linhagem no pacote</span>)
        : linhagem.origins.length === 0
          ? <span class="ausente">nenhuma origem declarada</span>
          : <ul class="sem-marcador">{linhagem.origins.map((o) => <li>{lnk(o.column) ? <a href={lnk(o.column)}><code>{o.column}</code></a> : <code>{o.column}</code>} <span class="etiqueta">{ORIGEM[o.kind] ?? o.kind}</span></li>)}</ul>}
    </td>
  </tr>
))}
</tbody></table></div>
<p class="suave">
  Tipos de origem terminal: <strong>origem</strong> é uma coluna de <em>source</em>; <strong>seed</strong> é uma tabela de referência versionada no projeto;
  <strong>valor gerado</strong> é um valor criado na transformação, como uma constante ou um rótulo de sistema.
  Os três são finais válidos de um caminho de linhagem. Nenhum deles indica quebra de linhagem.
  O tipo da coluna só vem declarado em <code>analytics</code> e <code>consumption</code>.
</p>

<h2 id="amostra">Amostra de registros</h2>
{amostra.row_count === 0
  ? <p><span class="ausente">A relação estava vazia no build da amostra.</span></p>
  : <>
<p>
  {amostra.rows.length === amostra.row_count ? `Todas as ${amostra.row_count} linhas` : `${amostra.rows.length} de ${amostra.row_count.toLocaleString("pt-BR")} linhas`},
  {amostra.order.defect_first ? " primeiro as que têm defeito registrado do legado, depois as demais," : ""} na ordem da chave
  {amostra.order.key.map((c) => <code>{c}</code>).reduce((a, b) => [a, ", ", b])}.
</p>
<div class="rolagem"><table class="amostra">
<thead><tr>{amostra.columns.map((c) => <th scope="col"><a href={`#coluna-${c}`}><code>{c}</code></a>{mascaradas.has(c) && <div class="suave">personal</div>}</th>)}</tr></thead>
<tbody>
{amostra.rows.map((linha) => (
  <tr>{linha.map((v) => (
    <td>{v === null
      ? <span class="suave">nulo</span>
      : v === MARCADOR_PESSOAL
        ? <span class="etiqueta" title="valor de coluna personal mascarado pela origem">mascarado</span>
        : typeof v === "object"
          ? <details><summary>JSON</summary><pre>{jsonDaCelula(v)}</pre></details>
          : <code>{String(v)}</code>}</td>
  ))}</tr>
))}
</tbody></table></div>
</>}
<p class="suave">
  Exportada pela origem em {dataHora(amostras.exported_at)}, do build do commit <code>{amostras.provenance.built_from_commit.slice(0, 7)}</code>
  (invocação <code>{amostras.provenance.invocation_id}</code>, procedência <code>{amostras.provenance.status}</code>), ambiente <code>{amostras.environment}</code>,
  dados até {amostras.as_of_date ?? <span class="ausente">data ausente</span>}. A amostra retrata esse build, não o banco de agora.
  Todo valor de coluna <code>personal</code> aparece como <span class="etiqueta">mascarado</span>, também nas folhas dos JSON do legado
  ({adr0058 ? <a href={adr0058}>ADR-0058 da origem</a> : "ADR-0058 da origem"}); o nulo continua nulo. A máscara é uma concessão ao público anônimo, não uma mudança de classificação.
  {amostra.order.defect_first && " Nesta relação, o conteúdo que um defeito do legado deslocou para uma coluna não pessoal aparece como está, por decisão do Owner."}
</p>

<h2><Conceito id="teste">Testes</Conceito></h2>
{x.testes.length === 0 ? <p><span class="ausente">Nenhum teste declarado para esta relação.</span></p> : (
<div class="rolagem"><table>
<thead><tr><th scope="col">Teste</th><th scope="col">Tipo</th><th scope="col">Coluna</th><th scope="col">Referência</th><th scope="col">Declarado em</th><th scope="col">Resultado</th></tr></thead>
<tbody>
{x.testes.map((t) => (
  <tr>
    <td><code>{t.test}</code></td>
    <td>{t.kind}</td>
    <td>{t.column == null ? <span class="suave">relação</span> : <a href={`#coluna-${t.column}`}><code>{t.column}</code></a>}</td>
    <td>{t.references_relation == null ? <span class="suave">—</span> : lnkRef(t.references_relation, t.references_column) ? <a href={lnkRef(t.references_relation, t.references_column)}><code>{t.references_relation}.{t.references_column}</code></a> : <code>{t.references_relation}.{t.references_column}</code>}</td>
    <td>{rotaDaReferencia(t.declared_in) ? <a href={rotaDaReferencia(t.declared_in)}><code>{t.declared_in}</code></a> : <code>{t.declared_in}</code>}</td>
    <td><Resultado resultado={t.result} />{t.result && !t.result.same_invocation_as_manifest && <div class="suave">execução diferente da do manifesto</div>}</td>
  </tr>
))}
</tbody></table></div>)}
<p class="suave">
  Os resultados são os da execução registrada no pacote, não do estado atual do banco.
  Num teste <code>relationships</code>, a referência é a coluna de outra relação em que todo valor da coluna testada deve existir.
  As chaves estrangeiras da ficha acima são as que a origem instala no banco ({adr0056 ? <a href={adr0056}>ADR-0056 da origem</a> : "ADR-0056 da origem"}); um teste <code>relationships</code> sem chave correspondente confere o valor, mas não instala a ligação.
</p>
</Base>
