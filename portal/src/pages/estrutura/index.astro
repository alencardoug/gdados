---
// Estrutura do projeto e ambientes (PLANO §3; mapeamento §2.2). Camadas e materializações derivadas
// de relations; travessias de crossings (Mermaid, só nesta página: D02, condição 3); artefatos de
// infraestrutura e documentos de environments, lidos por commit.
import Conceito from "../../components/Conceito.astro";
import Base from "../../layouts/Base.astro";
import Md from "../../components/Md.astro";
import Resultado from "../../components/Resultado.astro";
import { pacote, procedencia, relacoes, relacaoPorId, camadas, rota, rotaDaRelacao, rotaDaColuna, rotaDaReferencia, mdDoPacoteEmLinha, data, caminhosCopiados, fksDoPacote, naoNulas, modeloER, camadasComChave } from "../../lib/portal.mjs";
import { definicaoER, vizinhos } from "../../lib/er.mjs";
import { semMarcacao } from "../../lib/markdown.mjs";

// Camadas e materializações (perspectiva física).
const porCamada = camadas.map((c) => {
  const xs = relacoes.filter((x) => x.camada === c);
  const combinacoes = {};
  for (const x of xs) {
    const k = `${x.r.resource_type}${x.r.materialization ? ` · ${x.r.materialization}` : ""}`;
    combinacoes[k] = (combinacoes[k] ?? 0) + 1;
  }
  const papeis = [...new Set(xs.flatMap((x) => x.r.grants_select))].sort();
  return { camada: c, n: xs.length, combinacoes, papeis };
});

// Travessias: diagrama Mermaid gerado do pacote. Rótulo = texto plano, com aspas e < > codificados.
const rotulo = (s, n = 48) => {
  const t = semMarcacao(s);
  return (t.length > n ? `${t.slice(0, n - 1)}…` : t).replace(/#/g, "#35;").replace(/"/g, "#quot;").replace(/</g, "#lt;").replace(/>/g, "#gt;");
};
const ids = new Map();
const idDe = (texto) => ids.get(texto) ?? ids.set(texto, `n${ids.size}`).get(texto);
const linhas = [
  "flowchart LR",
  "  accTitle: Travessias fora do dbt",
  "  accDescr: Como os dados chegam às camadas de origem do armazém, conforme crossings do pacote de metadados",
];
for (const t of pacote.crossings) {
  const o = idDe(t.origin), d = idDe(t.destination);
  linhas.push(`  ${o}["${rotulo(t.origin)}"] -->|"${rotulo(t.mechanism.split(/ — |, |\(/)[0], 36)}"| ${d}["${rotulo(t.destination)}"]`);
}
const definicao = linhas.join("\n");
const travessias = await Promise.all(
  pacote.crossings.map(async (t) => ({
    origem: await mdDoPacoteEmLinha(t.origin),
    destino: await mdDoPacoteEmLinha(t.destination),
    mecanismo: await mdDoPacoteEmLinha(t.mechanism),
    frequencia: await mdDoPacoteEmLinha(t.frequency),
    nota: await mdDoPacoteEmLinha(t.note),
  })),
);

// Diagrama entidade-relacionamento (F34): um recorte por relação do modelo (ela e as ligadas a ela por
// chave) e o modelo inteiro. Abre num recorte, como na linhagem (D02, condição 1): o da relação com mais
// chaves estrangeiras próprias, que mostra uma estrela inteira.
const ligacoesDe = (id) => fksDoPacote.filter((f) => f.relacao === id || f.references_relation === id).length;
const saidasDe = (id) => fksDoPacote.filter((f) => f.relacao === id).length;
const recortesER = modeloER
  .map((id) => ({ id, rotulo: `${id} (${ligacoesDe(id)} ${ligacoesDe(id) === 1 ? "ligação" : "ligações"})`, definicao: definicaoER(pacote, vizinhos(pacote, id), { titulo: `Recorte de ${id}`, foco: id }) }))
  .sort((a, b) => saidasDe(b.id) - saidasDe(a.id) || ligacoesDe(b.id) - ligacoesDe(a.id) || a.id.localeCompare(b.id));
const modeloInteiro = modeloER.length ? { id: "modelo-inteiro", rotulo: `Modelo inteiro (${modeloER.length} relações, ${fksDoPacote.length} ligações)`, definicao: definicaoER(pacote, modeloER, { titulo: "Modelo entidade-relacionamento" }) } : null;
const lnkCol = (rel, col) => (relacaoPorId.has(rel) ? rotaDaColuna(rel, col) : null);
const resultadoDoTeste = (f) => Object.values(pacote.tests).find((t) => t.test === "relationships" && t.relation === f.relacao && t.column === f.column && t.references_relation === f.references_relation && t.references_column === f.references_column)?.result ?? null;
const adr0056 = rotaDaReferencia("docs/adr/0056-chaves-declaradas-em-analytics.md");

const ENTREGA = { read_by_commit: "lido por commit", not_available: "indisponível" };
const comGrao = relacoes.filter((x) => x.r.grain != null);
const pastasRaiz = [...new Set(caminhosCopiados.map((c) => c.split("/")[0]))].sort();
import LadoALado from "../../components/LadoALado.astro";
---
<Base titulo="Estrutura e ambientes" secao="estrutura" descricao="Camadas, travessias, infraestrutura local e GCP.">
<h1>Estrutura do projeto e ambientes</h1>
<p class="lead">
  O projeto pode ser visto por várias perspectivas: negócio, modelo lógico, implementação física, infraestrutura e código.
  Esta página separa o que o projeto <strong>declara</strong> (configuração e código), o que foi <strong>registrado</strong> numa data
  (execução e evidência) e o que <strong>não está disponível</strong> ao portal.
</p>
<nav aria-label="Nesta página"><a href="#fisica">Camadas</a> · <a href="#travessias">Travessias</a> · <a href="#logica">Entidades e grãos</a> · <a href="#entidades">Relacionamentos</a> · <a href="#lado-a-lado">Local e GCP</a> · <a href="#ambientes">Ambientes e documentos</a> · <a href="#arquivos">Arquivos da origem</a></nav>

<h2 id="fisica"><Conceito id="camada">Camadas</Conceito> e <Conceito id="materializacao">materializações</Conceito></h2>
<p>As camadas aparecem na ordem do pipeline, calculada pela linhagem. A materialização diz como cada objeto existe no banco: tabela, view, incremental, snapshot ou seed. Uma <em>source</em> não é materializada pelo dbt; ela é a origem.</p>
<div class="rolagem"><table>
<thead><tr><th scope="col">Camada (schema)</th><th scope="col">Relações</th><th scope="col">Tipo · materialização</th><th scope="col">Papéis com leitura em alguma relação</th></tr></thead>
<tbody>
{porCamada.map((c) => (
  <tr>
    <th scope="row" class="marca-camada" data-camada={c.camada}><a href={rota(`governanca/?camada=${c.camada}#catalogo`)}>{c.camada}</a></th>
    <td>{c.n}</td>
    <td>{Object.entries(c.combinacoes).map(([k, n]) => <div>{k}: {n}</div>)}</td>
    <td>{c.papeis.length ? c.papeis.map((p) => <code>{p}</code>).reduce((a, b) => [a, ", ", b]) : <span class="ausente">nenhuma concessão</span>}</td>
  </tr>
))}
</tbody></table></div>
<p class="suave">Um schema separa os nomes dentro do banco. Ele não garante, sozinho, que o armazenamento fique isolado. Os papéis com leitura vêm de <code>grants_select</code>.</p>

<h2 id="travessias"><Conceito id="travessia">Travessias</Conceito> fora do dbt</h2>
<p>Antes do dbt, os dados chegam às camadas de origem por ingestão em lote, por <em>streaming</em> e por captura do legado. A ligação é por camada, como o pacote a declara: não há precisão por coluna nessas travessias.</p>
<div id="diagrama" class="diagrama" data-definicao={definicao}><p class="suave">Carregando o diagrama…</p></div>
<details><summary>Definição do diagrama (Mermaid, gerada do pacote)</summary><pre><code>{definicao}</code></pre></details>
<h3>Travessias (alternativa em tabela)</h3>
<div class="rolagem"><table>
<thead><tr><th scope="col">Origem</th><th scope="col">Destino</th><th scope="col">Mecanismo</th><th scope="col">Frequência</th><th scope="col">Nota</th></tr></thead>
<tbody>
{travessias.map((t) => (
  <tr>
    <td class="md"><Md html={t.origem} em="span" /></td>
    <td class="md"><Md html={t.destino} em="span" /></td>
    <td class="md"><Md html={t.mecanismo} em="span" /></td>
    <td class="md"><Md html={t.frequencia} em="span" /></td>
    <td class="md"><Md html={t.nota} em="span" /></td>
  </tr>
))}
</tbody></table></div>

<h2 id="logica"><Conceito id="entidade-e-relacionamento">Entidades</Conceito> e <Conceito id="grao">grãos</Conceito></h2>
<p>
  O grão diz o que uma linha representa. É o primeiro passo para ler um fato ou uma dimensão.
  Abaixo estão as relações que declaram grão no pacote.
</p>
<div class="rolagem"><table>
<thead><tr><th scope="col">Relação</th><th scope="col">Grão declarado</th><th scope="col">Domínio</th></tr></thead>
<tbody>
{comGrao.map((x) => (
  <tr><td><a href={rotaDaRelacao(x.id)}><code>{x.id}</code></a></td><td>{x.r.grain}</td><td>{x.r.meta?.domain ?? <span class="ausente">não declarado</span>}</td></tr>
))}
</tbody></table></div>

<h2 id="entidades"><Conceito id="entidade-e-relacionamento">Relacionamentos</Conceito> entre as relações</h2>
{modeloInteiro == null ? <p><span class="ausente">Nenhuma chave primária ou estrangeira declarada no pacote da {procedencia.ref}.</span></p> : <>
<p>
  O diagrama é gerado das <Conceito id="chave">chaves</Conceito> primárias e estrangeiras que o pacote declara (<code>primary_key</code> e <code>foreign_keys</code>).
  No pacote da <code>{procedencia.ref}</code>, só {camadasComChave.map((c) => <code>{c}</code>).reduce((a, b) => [a, ", ", b])} declara chaves: são as que a origem instala no banco
  ({adr0056 ? <a href={adr0056}>ADR-0056 da origem</a> : "ADR-0056 da origem"}). O portal não deduz ligações pelo nome das colunas nem dos testes.
</p>
<p>
  Escolha uma relação para ver só ela e as relações ligadas a ela por chave, ou o modelo inteiro.
  Na ponta da relação que aponta, a linha diz "zero ou mais". Na ponta da relação apontada, diz "exatamente um" quando a coluna tem teste <code>not_null</code> declarado,
  e "zero ou um" quando não tem: o pacote não declara a cardinalidade (<a href={rota("conceitos/limitacoes/#cardinalidade-dos-relacionamentos")}>limitação conhecida</a>).
</p>
<label class="seletor-de-recorte">Recorte <select id="er-recorte">
  {recortesER.map((r) => <option value={r.id} data-definicao={r.definicao}>{r.rotulo}</option>)}
  <option value={modeloInteiro.id} data-definicao={modeloInteiro.definicao}>{modeloInteiro.rotulo}</option>
</select></label>
<div id="er-diagrama" class="diagrama" data-definicao={recortesER[0]?.definicao ?? modeloInteiro.definicao}><p class="suave">Carregando o diagrama…</p></div>
<details><summary>Definição do diagrama (Mermaid, gerada do pacote)</summary><pre><code id="er-definicao">{recortesER[0]?.definicao ?? modeloInteiro.definicao}</code></pre></details>
<h3>Chaves estrangeiras (alternativa em tabela)</h3>
<div class="rolagem"><table>
<thead><tr><th scope="col">Relação</th><th scope="col">Coluna</th><th scope="col">Referência</th><th scope="col">Teste <code>not_null</code></th><th scope="col">Teste <code>relationships</code></th></tr></thead>
<tbody>
{fksDoPacote.map((f) => (
  <tr>
    <td><a href={rotaDaRelacao(f.relacao)}><code>{f.relacao}</code></a></td>
    <td>{lnkCol(f.relacao, f.column) ? <a href={lnkCol(f.relacao, f.column)}><code>{f.column}</code></a> : <code>{f.column}</code>}</td>
    <td>{lnkCol(f.references_relation, f.references_column) ? <a href={lnkCol(f.references_relation, f.references_column)}><code>{f.references_relation}.{f.references_column}</code></a> : <code>{f.references_relation}.{f.references_column}</code>}</td>
    <td>{naoNulas.has(`${f.relacao}.${f.column}`) ? "declarado" : <span class="suave">não declarado</span>}</td>
    <td><Resultado resultado={resultadoDoTeste(f)} /></td>
  </tr>
))}
</tbody></table></div>
<p class="suave">Os resultados são os da execução registrada no pacote. Uma chave estrangeira sem teste <code>relationships</code> correspondente apareceria como "sem resultado".</p>
</>}

<LadoALado />

<h2 id="ambientes">Ambientes e documentos</h2>
<p>
  Artefatos que o pacote indica para esta página (<code>environments</code>). Os lidos por commit estão copiados no portal com o restante da origem.
  Uma data de congelamento indica que o conteúdo descreve um estado encerrado naquela data.
</p>
<div class="rolagem"><table>
<thead><tr><th scope="col">Artefato</th><th scope="col">Caminho</th><th scope="col">Entrega</th><th scope="col">Congelado em</th><th scope="col">Nota</th></tr></thead>
<tbody>
{pacote.environments.map((e) => {
  const href = e.delivery === "read_by_commit" && e.repository === procedencia.repository ? rotaDaReferencia(e.path) : null;
  return (
  <tr id={`ambiente-${e.id}`}>
    <th scope="row">{e.title}</th>
    <td>{href ? <a href={href}><code>{e.path}</code></a> : <code>{e.path}</code>}<div class="suave">{e.repository}{e.commit && <> em <code>{e.commit}</code></>}</div></td>
    <td><span class={`estado ${e.delivery}`}>{ENTREGA[e.delivery] ?? e.delivery}</span></td>
    <td>{e.frozen_at ? data(e.frozen_at) : <span class="suave">—</span>}</td>
    <td>{e.note ?? <span class="suave">—</span>}</td>
  </tr>
  );
})}
</tbody></table></div>
<p class="suave">
  <Conceito id="paridade">Paridade local ↔ GCP</Conceito>: o ambiente GCP foi desmontado. Desse lado, a comparação local ↔ GCP usa a declaração (Terraform, mapa de paridade) e o registro datado da fase GCP.
  Ela não usa uma observação atual. As evidências coletadas no GCP aparecem como indisponíveis enquanto a origem não decidir se e como entram.
</p>

<h2 id="arquivos">Arquivos da origem</h2>
<p>Arquivos que o portal lê por commit, fora do pacote, copiados no mesmo commit (<code>{procedencia.ref}</code>):</p>
<ul>{pastasRaiz.map((p) => <li><a href={rotaDaReferencia(`${p}/`)}><code>{p}/</code></a></li>)}</ul>
</Base>
<script>
import mermaid from "mermaid";
import { configurarMermaid, redesenharNaTroca } from "../../cliente/mermaid-tema.js";
const alvo = document.getElementById("diagrama");
// No ER, o desenho fica no tamanho natural e a área rola na horizontal: reduzido, o modelo inteiro fica ilegível.
const OPCOES = { er: { useMaxWidth: false } };
configurarMermaid(mermaid, OPCOES);
let versao = 0;
const desenharTravessias = () => mermaid.render(`travessias-svg-${++versao}`, alvo.dataset.definicao).then(({ svg }) => {
  alvo.innerHTML = svg;
  performance.mark("travessias:pronto");
  alvo.dataset.pronto = "1";
}).catch((e) => {
  alvo.textContent = `O diagrama não pôde ser desenhado (${e.message}). As travessias estão na tabela abaixo.`;
});
let travessias = desenharTravessias();

// Diagrama entidade-relacionamento: um recorte por vez, escolhido no seletor ou por ?er=<relação>.
const er = document.getElementById("er-diagrama");
const seletor = document.getElementById("er-recorte");
const textoER = document.getElementById("er-definicao");
let vez = 0;
const desenharER = async () => {
  const opcao = seletor.selectedOptions[0];
  const definicao = opcao.dataset.definicao;
  const minha = ++vez;
  textoER.textContent = definicao;
  er.dataset.pronto = "";
  try {
    const { svg } = await mermaid.render(`er-svg-${minha}`, definicao);
    if (minha !== vez) return;
    er.innerHTML = svg;
    er.dataset.pronto = "1";
  } catch (e) {
    if (minha === vez) er.textContent = `O diagrama não pôde ser desenhado (${e.message}). As chaves estão na tabela abaixo.`;
  }
};
if (er && seletor) {
  const pedido = new URLSearchParams(location.search).get("er");
  if (pedido != null && [...seletor.options].some((o) => o.value === pedido)) seletor.value = pedido;
  seletor.addEventListener("change", () => {
    const url = new URL(location.href);
    url.searchParams.set("er", seletor.value);
    history.replaceState(null, "", url);
    travessias.then(desenharER);
  });
  travessias.then(desenharER);
}
redesenharNaTroca(mermaid, OPCOES, () => {
  travessias = desenharTravessias();
  if (er && seletor) travessias.then(desenharER);
});
</script>
