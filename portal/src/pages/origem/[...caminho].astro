---
// Arquivos da origem lidos por commit (D03; mapeamento §3), copiados em origem/arquivos/.
// Markdown é exibido saneado; os demais formatos, como texto. Cada pasta tem um índice.
import Base from "../../layouts/Base.astro";
import Md from "../../components/Md.astro";
import {
  caminhosCopiados, pastasCopiadas, procedencia, rota, rotaDoArquivo, registroDoArquivo, lerArquivo, mdDoArquivo, commitCurto,
} from "../../lib/portal.mjs";

export function getStaticPaths() {
  return [
    ...caminhosCopiados.map((c) => ({ params: { caminho: c }, props: { pasta: false } })),
    ...pastasCopiadas.map((p) => ({ params: { caminho: p.replace(/\/$/, "") }, props: { pasta: true } })),
  ];
}
const { pasta } = Astro.props;
const caminho = Astro.params.caminho;
const partes = caminho.split("/");
const migalhas = partes.slice(0, -1).map((_, i) => ({ rotulo: partes[i], href: rotaDoArquivo(`${partes.slice(0, i + 1).join("/")}/`) }));
let conteudo = null, html = null, filhos = [];
if (pasta) {
  const prefixo = `${caminho}/`;
  const diretos = new Set();
  for (const c of [...caminhosCopiados, ...pastasCopiadas]) {
    if (!c.startsWith(prefixo) || c === prefixo) continue;
    const resto = c.slice(prefixo.length);
    const i = resto.indexOf("/");
    diretos.add(i < 0 || i === resto.length - 1 ? resto : resto.slice(0, i + 1));
  }
  filhos = [...diretos].sort((a, b) => (a.endsWith("/") === b.endsWith("/") ? a.localeCompare(b) : a.endsWith("/") ? -1 : 1));
} else if (caminho.endsWith(".md")) {
  html = await mdDoArquivo(caminho);
} else {
  conteudo = lerArquivo(caminho);
}
const registro = pasta ? null : registroDoArquivo(caminho);
---
<Base titulo={caminho} secao="estrutura">
<p class="migalhas">
  <a href={rota("estrutura/#arquivos")}>Arquivos da origem</a>
  {migalhas.map((m) => <> › <a href={m.href}>{m.rotulo}</a></>)}
</p>
<h1><code>{caminho}{pasta ? "/" : ""}</code></h1>
<p class="suave">
  Texto de <code>{procedencia.repository}</code> no commit <code title={procedencia.commit}>{commitCurto(procedencia.commit)}</code> (<code>{procedencia.ref}</code>), copiado sem alteração.
  {registro && <> SHA-256 <code>{registro.sha256.slice(0, 16)}…</code>, {registro.bytes.toLocaleString("pt-BR")} bytes.</>}
  Este conteúdo pertence à origem. O portal exibe o texto e não o reinterpreta.
  {html && <> Links para arquivos que não foram copiados aparecem <span class="fora-da-copia">assim</span>, sem destino.</>}
</p>
{pasta ? (
  <ul>{filhos.map((f) => <li><a href={rotaDoArquivo(`${caminho}/${f}`)}><code>{f}</code></a></li>)}</ul>
) : html ? (
  <article class="documento"><Md html={html} /></article>
) : (
  <pre><code>{conteudo}</code></pre>
)}
</Base>
