---
// Página de conceitos e artefatos (PLANO §4; docs/pagina_de_conceitos.md): entrada própria, índice
// por assunto e alfabético, definições da origem e situação de cada explicação do portal.
import Base from "../../layouts/Base.astro";
import { gruposComTermos, termos, limitacoes, percursos } from "../../lib/editorial.mjs";
import { caminhosCopiados, lerArquivo, rota, rotaDaReferencia, procedencia } from "../../lib/portal.mjs";
import { semMarcacao } from "../../lib/markdown.mjs";

const titulo = (c) => semMarcacao((/^#\s+(.+)$/m.exec(lerArquivo(c)) ?? [null, c.split("/").pop()])[1]);
const glossarios = ["docs/glossario.md", "docs/glossario_de_negocio/README.md"].filter((c) => caminhosCopiados.includes(c));
const conceitosDeNegocio = caminhosCopiados
  .filter((c) => /^docs\/glossario_de_negocio\/.+\.md$/.test(c) && !/README\.md$/.test(c))
  .map((c) => ({ caminho: c, titulo: titulo(c) }))
  .sort((a, b) => a.titulo.localeCompare(b.titulo, "pt-BR"));
const alfabetica = [...termos].sort((a, b) => a.titulo.localeCompare(b.titulo, "pt-BR"));
const escritos = termos.filter((t) => t.escrito).length;
const TIPO = { relacao: "relação", coluna: "coluna", pergunta: "pergunta", metrica: "métrica", filtro: "filtro", arquivo: "arquivo da origem", pagina: "página do portal" };
---
<Base titulo="Conceitos e artefatos" secao="conceitos" descricao="Fundamentos para ler o catálogo, a linhagem e os ambientes.">
<p id="retorno" hidden></p>
<h1>Conceitos e artefatos</h1>
<p class="lead">
  Os fundamentos para interpretar as outras páginas: o que é cada termo, que problema resolve, como aparece neste projeto e onde vê-lo na prática.
  Cada página separa a <strong>definição da origem</strong>, a <strong>explicação do portal</strong>, a <strong>aplicação real</strong> e o <strong>exemplo didático</strong>.
</p>
<p>
  O inventário tem {termos.length} termos. {escritos} já têm explicação do portal; nos demais, a página mostra a definição da origem, quando existe,
  e marca a explicação como pendente. Veja também as <a href={rota("conceitos/limitacoes/")}>limitações conhecidas</a> ({limitacoes.length}).
</p>
<nav aria-label="Nesta página"><a href="#percursos">Percursos</a> · <a href="#por-assunto">Por assunto</a> · <a href="#alfabetica">Ordem alfabética</a> · <a href="#origem">Definições da origem</a></nav>

<h2 id="percursos">Percursos de leitura</h2>
<p>Sugestões de caminho, dos fundamentos até objetos reais do projeto. Nenhum percurso é obrigatório: o catálogo e a linhagem podem ser explorados a qualquer momento.</p>
{percursos.map((p) => (
  <section id={`percurso-${p.id}`} class="bloco portal">
    <h3>{p.titulo}</h3>
    <p>{p.objetivo}</p>
    <ol>
      {p.passos.map((passo) => (
        <li>{passo.rotulo}: {passo.termos.map((t) => <><a href={t.href}>{t.titulo}</a>{!t.escrito && <span class="suave"> (pendente)</span>}</>).reduce((a, b) => [a, ", ", b])}</li>
      ))}
    </ol>
    <p><strong>Na prática:</strong></p>
    <ul>
      {p.pratica.map((e) => (
        <li><span class="etiqueta">{TIPO[e.tipo]}</span>{" "}{e.existe ? <a href={e.href}><code>{e.ref}</code></a> : <><code>{e.ref}</code> <span class="ausente">não encontrado no pacote fixado</span></>}{e.nota && <span class="suave"> — {e.nota}</span>}</li>
      ))}
    </ul>
  </section>
))}

<h2 id="por-assunto">Por assunto</h2>
{gruposComTermos.map((g) => (
  <section id={`grupo-${g.id}`}>
    <h3>{g.titulo}</h3>
    <ul>
      {g.termos.map((t) => (
        <li>
          <a href={t.href}>{t.titulo}</a>
          {t.escrito ? null : <span class="suave"> · explicação pendente</span>}
          {t.definicoes.length > 0 && <span class="suave"> · definição na origem</span>}
          {t.divergencias.length > 0 && <span class="estado fail">divergência entre fontes</span>}
        </li>
      ))}
    </ul>
  </section>
))}

<h2 id="alfabetica">Ordem alfabética</h2>
<ul class="indice-alfabetico">{alfabetica.map((t) => <li><a href={t.href}>{t.titulo}</a></li>)}</ul>

<h2 id="origem">Definições da origem</h2>
<p class="suave">Textos de <code>{procedencia.repository}</code> na <code>{procedencia.ref}</code>. A origem é a responsável por essas definições.</p>
<ul>{glossarios.map((g) => <li><a href={rotaDaReferencia(g)}>{titulo(g)}</a> <span class="suave">(<code>{g}</code>)</span></li>)}</ul>
<h3>Conceitos de negócio</h3>
<ul class="indice-alfabetico">{conceitosDeNegocio.map((c) => <li><a href={rotaDaReferencia(c.caminho)}>{c.titulo}</a></li>)}</ul>
</Base>
