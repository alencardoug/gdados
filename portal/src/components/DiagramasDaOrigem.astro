---
// Desenha os blocos ```mermaid dos documentos da origem (ex.: os diagramas entidade-relacionamento
// gerados pela origem no Modelo de Dados). Só é incluído nas páginas que têm esses blocos (D02,
// condição 3). O texto vem da origem: securityLevel "strict", e o código-fonte continua visível
// como alternativa textual e definição declarativa.
---
<script>
import mermaid from "mermaid";
import { configurarMermaid, redesenharNaTroca } from "../cliente/mermaid-tema.js";
const blocos = [...document.querySelectorAll("pre > code.language-mermaid")];
configurarMermaid(mermaid);
// Prepara uma vez: a figura no lugar do bloco e a definição da origem recolhida logo abaixo.
const pares = blocos.map((code) => {
  const pre = code.parentElement;
  const figura = document.createElement("div");
  figura.className = "diagrama";
  const detalhes = document.createElement("details");
  const resumo = document.createElement("summary");
  resumo.textContent = "Definição do diagrama (Mermaid, texto da origem)";
  pre.replaceWith(figura);
  detalhes.append(resumo, pre);
  figura.after(detalhes);
  return { figura, detalhes, definicao: code.textContent };
});
let versao = 0;
const desenhar = async () => {
  const minha = ++versao;
  let i = 0;
  for (const { figura, detalhes, definicao } of pares) {
    try {
      const { svg } = await mermaid.render(`origem-diagrama-${minha}-${i++}`, definicao);
      if (minha !== versao) return;
      figura.innerHTML = svg;
    } catch (e) {
      figura.textContent = `O diagrama não pôde ser desenhado (${e.message}). A definição está logo abaixo.`;
      detalhes.open = true;
    }
  }
};
await desenhar();
document.documentElement.dataset.diagramasProntos = String(blocos.length);
redesenharNaTroca(mermaid, {}, desenhar);
</script>
