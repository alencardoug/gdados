---
import Identificador from "./Identificador.astro";
import { modeloER, rotaDaColuna, rotaDaRelacao, rotaDoER } from "../lib/portal.mjs";
import "../styles/esquema-estrela.css";
const { star, dimensions } = Astro.props;
const { arms } = star;
const used = new Set(dimensions);
const indirect = dimensions?.filter((id) => !arms.some((a) => a.target === id)) ?? [];
const half = Math.ceil(arms.length / 2);
const sides = [arms.slice(0, half), arms.slice(half)];
---
<div class="fact-star" data-fact={star.id}>
  <p class="star-key">Cada dimensão descreve um lado da linha da fato. Em cada braço, a chave estrangeira (FK) da fato aponta para a chave primária (PK) da dimensão.
    {dimensions?.length > 0 && " O destaque identifica as dimensões declaradas para a pergunta."}</p>
  <div class="star-layout">
    <div class="star-hub">
      <span>Fato · <code>analytics</code></span>
      <strong><Identificador value={star.name} /></strong>
      <p>Uma linha da fato = <b>{star.grain ?? "grão não declarado"}</b></p>
      {star.primaryKey.length > 0 && <small>PK {star.primaryKey.map((key, i) => <>{i > 0 && " · "}<Identificador value={key} /></>)}</small>}
    </div>
    {sides.map((side, index) => side.length > 0 && <div class:list={["star-side", index === 0 ? "before-hub" : "after-hub"]}>
      <ul class="star-nodes" role="list">
        {side.map((arm) => <li class="star-arm" data-dimension={arm.target} data-used={used.has(arm.target) ? "true" : undefined}>
          <a href={rotaDaRelacao(arm.target)}><Identificador value={arm.dimension} /></a>
          {arm.grain && <span>{arm.grain}</span>}
          <div class="arm-keys"><Identificador value={arm.fk} /> → <Identificador value={arm.pk} /></div>
          {arm.snapshots.map((id) => <a class="snapshot-link" href={rotaDaRelacao(id)}>Usa snapshot <Identificador value={id.split(".").at(-1)} /></a>)}
          {used.has(arm.target) && <b class="dimension-in-question">Dimensão da pergunta</b>}
        </li>)}
      </ul>
      <svg class="star-fan" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
        {side.map((arm, i) => <line x1={index === 0 ? 100 : 0} y1="50" x2={index === 0 ? 0 : 100}
          y2={100 * (i + 0.5) / side.length} class:list={[used.has(arm.target) && "used"]} vector-effect="non-scaling-stroke" />)}
      </svg>
    </div>)}
  </div>
  {!arms.length && <p>O pacote não declara ligação direta entre uma FK desta fato e a PK de uma dimensão.</p>}
  {indirect.length > 0 && <p class="star-key">Dimensões da pergunta sem FK direta nesta fato · {indirect.map((id, i) =>
    <>{i > 0 && ", "}<a href={rotaDaRelacao(id)}><Identificador value={id} /></a></>)}</p>}
  {arms.length > 0 && <details class="star-table"><summary>Ler as ligações FK → PK em tabela</summary>
    <table><thead><tr><th scope="col">FK da fato</th><th scope="col">PK da dimensão</th></tr></thead>
      <tbody>{arms.map((arm) => <tr>
        <td><a href={rotaDaColuna(star.id, arm.fk)}><Identificador value={arm.fk} /></a></td>
        <td><a href={rotaDaColuna(arm.target, arm.pk)}><Identificador value={arm.target + "." + arm.pk} /></a>
          {used.has(arm.target) && <small>Dimensão da pergunta</small>}</td>
      </tr>)}</tbody>
    </table>
  </details>}
  {modeloER.includes(star.id) && <a class="star-er" href={rotaDoER(star.id)}>Ver a fato no diagrama entidade-relacionamento</a>}
</div>
